                </div>

                <!-- Estatísticas -->
                <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-6">
                    <div class="bg-white rounded-lg shadow-md p-6">
                        <h3 class="text-gray-600 text-sm font-medium">Total de Cirurgias</h3>
                        <p id="totalCirurgias" class="text-3xl font-bold text-blue-600 mt-2">0</p>
                    </div>
                    <div class="bg-white rounded-lg shadow-md p-6">
                        <h3 class="text-gray-600 text-sm font-medium">Cirurgias Hoje</h3>
                        <p id="cirurgiasHoje" class="text-3xl font-bold text-green-600 mt-2">0</p>
                    </div>
                    <div class="bg-white rounded-lg shadow-md p-6">
                        <h3 class="text-gray-600 text-sm font-medium">Cirurgias Este Mês</h3>
                        <p id="cirurgiasMes" class="text-3xl font-bold text-purple-600 mt-2">0</p>
                    </div>
